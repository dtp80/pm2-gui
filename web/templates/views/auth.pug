extends ../layouts/default

block head
  link(rel='stylesheet', href='/css/auth.css')

block content
  .auth-page
    .auth-card
      .auth-brand
        .brand-mark PM2
        h1 PM2 Monitor
        p Sign in to continue
      form.auth-form#auth-form
        label(for='auth-input') Authorization token
        input#auth-input(type='password', placeholder='Enter token', autocomplete='current-password', maxlength='64')
        button.btn.btn-primary(type='submit') Continue
        p.auth-error#auth-error(hidden)

block js
  script(src='/js/auth.js')
